# 统一换行符，避免 Windows 上的 CRLF 转换破坏文件
* text=auto eol=lf

# 二进制文件严禁任何换行转换（PDF 的交叉引用表按字节偏移，转换后会损坏）
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary

# 文本资源显式声明为 LF
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
